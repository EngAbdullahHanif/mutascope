{
  "name": "mutascope-web",
  "private": true,
  "description": "MutaScope website: Next.js App Router, served with the bundle it was built with.",
  "packageManager": "pnpm@12.10.1",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/fetch-bundle.ts && next build",
    "start": "next start",
    "data:fetch": "node scripts/fetch-bundle.ts",
    "data:verify": "node scripts/fetch-bundle.ts --verify-only",
    "schemas": "node scripts/gen-bundle-schemas.ts && prettier --write src/lib/bundle/schemas.generated.ts",
    "types": "openapi-typescript openapi.json -o src/lib/api-types.ts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "size": "node scripts/bundle-size.ts",
    "lighthouse": "lhci autorun --config=lighthouserc.json"
  },
  "dependencies": {
    "3dmol": "2.5.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "next-themes": "0.4.6",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}

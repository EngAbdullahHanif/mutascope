# Environment of the MutaScope API (api.app.settings.Settings; ADR 0030-0033).
#
# Copy to .env for `docker compose up` (docker-compose.yml reads it) or set the variables on the
# Space. Every line is commented out: the value shown is the default (in the image, where it
# differs), so an empty .env runs the pinned release. Uncomment a line to change it.
# Never commit .env: it holds the metrics token and the Sentry DSN (.gitignore excludes it).
# Comma-separated lists are plain strings: a,b,c.

# --- Server (python -m api.app.serve: one process, one worker; ADR 0032) -----------------------
# Address and port the server binds. The Space expects 7860.
# MUTASCOPE_API_HOST=0.0.0.0
# MUTASCOPE_API_PORT=7860
# Concurrent connections uvicorn accepts; more get a 503.
# MUTASCOPE_API_MAX_CONNECTIONS=200
# Lock held while the server runs, so a second process refuses to start. Must be writable by
# UID 1000 in the image.
# MUTASCOPE_API_LOCK_FILE=/home/user/.cache/mutascope/api.lock

# --- What is served (pins; a test holds the defaults to conf/) ---------------------------------
# Hub dataset repo, folder and commit of the website bundle (bundle-v1.1.0). Commit hashes only.
# The image has this revision baked in and runs offline: another value fails at startup.
# MUTASCOPE_API_BUNDLE_REPO=engAbdullahHanif/mutascope-proteingym-v1.3
# MUTASCOPE_API_BUNDLE_PATH=bundle
# MUTASCOPE_API_BUNDLE_REVISION=1bfc294371d4adeb31d8613989bed9055f03409a
# Read a local bundle copy instead of the Hub (tests, development). Unset in production.
# MUTASCOPE_API_BUNDLE_DIR=
# Model configs served live (conf/model/<name>.yaml), fp32 ONNX only; and the ONNX repo commit.
# MUTASCOPE_API_ONNX_MODELS=["esm2_35m_onnx_fp32","esm2_150m_onnx_fp32"]
# MUTASCOPE_API_ONNX_REVISION=82e15287c50f45f771cca75ac3786f0376ecabb2
# ONNX Runtime intra-op threads per model (the free Space has 2 vCPUs). BLAS/OpenMP stay at 1.
# MUTASCOPE_API_ONNX_THREADS=2
# Forward passes (fast and precise) that run at once; one already uses ONNX_THREADS cores.
# MUTASCOPE_API_INFERENCE_CONCURRENCY=1
# Seconds a fast-mode request waits for a free slot before a 503 with Retry-After.
# MUTASCOPE_API_INFERENCE_WAIT_SECONDS=10
# Read ONNX files from an export directory instead of the Hub (tests). Unset in production.
# MUTASCOPE_API_ONNX_LOCAL_DIR=
# Hydra config root (the model configs). In the image: /app/conf.
# MUTASCOPE_API_CONFIG_DIR=/app/conf

# --- Live scoring (ADR 0031) -------------------------------------------------------------------
# Model of POST /v1/score without `model`: esm2_150m, or esm2_35m if 150M's fast-mode p95 on the
# Space exceeds 2 s at 1,000 residues (ADR 0029).
# MUTASCOPE_API_SCORE_DEFAULT_MODEL=esm2_150m
# Longest sequence a precise-mode job accepts (provisional until the Space is measured).
# MUTASCOPE_API_PRECISE_MAX_LENGTH=600
# Jobs that may wait behind the running one; one more is a 429.
# MUTASCOPE_API_JOB_QUEUE_SIZE=4
# Seconds a finished job and its result stay readable.
# MUTASCOPE_API_JOB_TTL_SECONDS=3600
# diskcache directory of live landscapes, and its size limit in bytes (LRU eviction). Must be
# writable by UID 1000 in the image.
# MUTASCOPE_API_SCORE_CACHE_DIR=/home/user/.cache/mutascope/scores
# MUTASCOPE_API_SCORE_CACHE_BYTES=268435456

# --- Read-only routes (ADR 0030) ---------------------------------------------------------------
# Parsed protein files kept in memory, and Cache-Control of the /v1 read routes.
# MUTASCOPE_API_PROTEIN_CACHE_SIZE=32
# MUTASCOPE_API_CACHE_CONTROL=public, max-age=3600

# --- Limits (ADR 0032; provisional until the Space is measured) --------------------------------
# Rate limits in the `limits` package's syntax (moving windows; `;` joins two limits).
# MUTASCOPE_API_RATE_LIMIT_READ=120/minute
# MUTASCOPE_API_RATE_LIMIT_SCORE=20/minute
# MUTASCOPE_API_RATE_LIMIT_SCORE_GLOBAL=120/minute
# MUTASCOPE_API_RATE_LIMIT_JOBS=2/minute;10/hour
# Queued or running jobs per client; open event streams per client and in total.
# MUTASCOPE_API_MAX_ACTIVE_JOBS_PER_CLIENT=1
# MUTASCOPE_API_MAX_STREAMS_PER_CLIENT=4
# MUTASCOPE_API_MAX_STREAMS_TOTAL=64
# Largest request body in bytes; more is a 413.
# MUTASCOPE_API_MAX_BODY_BYTES=16384
# Reverse proxies whose X-Forwarded-For is believed (addresses or networks). On the Space: the
# Space proxy's range, measured at deploy. Empty: every user shares the socket address's quota.
# MUTASCOPE_API_TRUSTED_PROXIES=
# Browser origins allowed by CORS: the production site and the Next.js dev server.
# MUTASCOPE_API_CORS_ORIGINS=http://localhost:3000

# --- Observability (ADR 0032) ------------------------------------------------------------------
# Bearer token of GET /metrics, at least 32 characters (secret). Unset: /metrics answers 404.
# MUTASCOPE_API_METRICS_TOKEN=
# Sentry is on only with a DSN (secret); no bodies, frame variables or sequences are sent.
# MUTASCOPE_API_SENTRY_DSN=
# MUTASCOPE_API_SENTRY_ENVIRONMENT=development
# MUTASCOPE_API_SENTRY_TRACES_SAMPLE_RATE=0.0

manifest {
    name            = 'mutascope'
    description     = 'Functional-effect landscapes for single amino-acid substitutions'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.10'
}

params {
    conf_dir        = "${projectDir.parent}/conf"
    // Download cache: the raw release and the committed manifest.yaml it is verified against.
    data_dir        = "${projectDir.parent}/data"
    processed_dir   = "${projectDir.parent}/data/processed"
    reports_dir     = "${projectDir.parent}/results/data"
    // Assay ids to run on (list, or comma-separated on the command line). null = all assays.
    assays          = null
    // Hydra overrides appended to every `mutascope` command, space-separated.
    hydra_overrides = ''
}

profiles {
    // Native run in the uv env: the only profile with MPS access on macOS. Also what CI uses,
    // on a runner where `uv sync` made .venv (no Docker image exists until Phase 4).
    local {
        process.executor = 'local'
        env {
            PATH                        = "${projectDir.parent}/.venv/bin:\$PATH"
            PYTORCH_ENABLE_MPS_FALLBACK = '1'
        }
    }

    // CPU-only, linux/amd64 to match the deployment target. Image is built in Phase 4; it will
    // also need params.data_dir mounted, since DOWNLOAD links into it.
    docker {
        docker.enabled    = true
        docker.runOptions = '--platform linux/amd64 -u $(id -u):$(id -g)'
        process.container = 'mutascope:dev'
    }

    // Smoke test on 2 small assays (198 residues each, two function types). AICDA's PDB has a
    // TITLE record, which Foldseek appends to the entry name (build log entry 5, problem 1).
    // Outputs go to pipeline/results/ (gitignored), never over the real processed data.
    test {
        params.assays          = ['AICDA_HUMAN_Gajula_2014_3cycles', 'B2L11_HUMAN_Dutta_2010_binding-Mcl-1']
        params.processed_dir   = "${projectDir}/results/processed"
        params.reports_dir     = "${projectDir}/results/reports"
        // structure_exceptions: the real list names 4 specific assays, and check-structures fails
        // on any exception missing from the reference, which a 2-assay subset always triggers.
        // ~zero_shot_scores: skips the 1.9 GB archive; no Phase 1 step reads it.
        params.hydra_overrides = 'data.structure_exceptions=null ~data.files.zero_shot_scores'
        process.resourceLimits = [cpus: 2, memory: 4.GB, time: 30.m]
    }
}

manifest {
    name            = 'mutascope'
    description     = 'Functional-effect landscapes for single amino-acid substitutions'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.10'
}

params {
    conf_dir        = "${projectDir.parent}/conf"
    // Download cache: the raw release and the committed manifest.yaml it is verified against.
    data_dir        = "${projectDir.parent}/data"
    processed_dir   = "${projectDir.parent}/data/processed"
    reports_dir     = "${projectDir.parent}/results/data"
    // Assay ids to run on (list, or comma-separated on the command line). null = all assays.
    assays          = null
    // Benchmark results (results/*.parquet) and the local MLflow store (mlflow.db + artifacts/).
    results_dir     = "${projectDir.parent}/results"
    tracking_dir    = "${projectDir.parent}/mlruns"
    // Zero-shot models to score with (conf/model/<name>.yaml groups) and scoring methods
    // (masked, wt = wild-type marginal); every combination runs. Lists, or comma-separated on
    // the command line.
    models          = ['esm2_35m', 'esm2_150m', 'esm2_650m', 'saprot_650m_af2']
    methods         = ['masked', 'wt']
    // Models scored with the masked marginal only, whatever params.methods says.
    masked_only_models = ['saprot_650m_af2']
    // Full landscapes (every residue, plus the full target where the benchmark region is
    // partial) for every model in params.models, then the completeness check. About 12 hours
    // of model time on an empty cache (ADR 0018); false skips both steps.
    landscapes      = true
    // Log-probability cache, the checkpoint of every scoring step. null = scoring.cache_dir
    // from the config (under data_dir). Its own parameter because the path is quoted on its
    // own in each command; hydra_overrides is split on spaces.
    cache_dir       = null
    // Hydra overrides appended to every `mutascope` command, space-separated.
    hydra_overrides = ''

    // Phase 3 (ADR 0027): feature store, the deployed supervised model and its release check.
    // false skips all of it. Needs params.landscapes (the store reads full landscapes).
    supervised      = true
    // Models whose landscapes and embeddings go into the feature store: features.models in
    // conf/features, which must be among params.models (their landscapes are checked).
    feature_models  = ['esm2_650m', 'saprot_650m_af2']
    // Embedding cache, the checkpoint of `features embed`. null = features.embedding_cache_dir
    // (under data_dir); quoted on its own, like cache_dir.
    embedding_cache_dir = null
    // The deployed run [model, feature set]: train.final (and train.uncertainty) in conf/train
    // name the same, and `train final` fails if its cv results or calibration rows are another's.
    final_run       = ['ridge', 'seq_struct']
    // Compare the deployed run's outputs with the ones already in results_dir/supervised and
    // processed_dir before replacing them, and publish nothing if any value differs. Turn off
    // only to publish a deliberately changed model.
    release_check   = true
    // LightGBM and MLP, the other rungs of ADR 0025's table: hours of compute (LightGBM on
    // seq_struct alone took ~5 h; ADR 0022), so off by default. Published unchecked.
    extra_models    = false
    extra_runs      = [['lgbm', 'seq_struct'], ['lgbm_pca', 'seq'], ['lgbm_pca', 'seq_struct'],
                       ['mlp_mse', 'seq_struct'], ['mlp_rank', 'seq_struct']]
    // Worker processes for the train steps; null = all cores but one.
    train_jobs      = null
    // train.max_variants_in_flight per model (the memory budget of the parallel train steps;
    // conf/train/default.yaml: 80000 for ridge on seq_struct). Results never depend on it.
    max_variants_in_flight = [ridge: 80000]
}

// The optional supervised runs are published as they finish; the deployed run's results only
// through CHECK_RELEASE.
process {
    withName: 'TRAIN_CV_EXTRA' {
        publishDir = [
            path: { "${params.results_dir}/supervised" },
            mode: 'copy',
            saveAs: { name -> name.tokenize('/').last() },
        ]
    }
}

profiles {
    // Native run in the uv env: the only profile with MPS access on macOS. Also what CI uses,
    // on a runner where `uv sync` made .venv (no Docker image exists until Phase 4).
    local {
        process.executor = 'local'
        env {
            PATH                        = "${projectDir.parent}/.venv/bin:\$PATH"
            PYTORCH_ENABLE_MPS_FALLBACK = '1'
        }
    }

    // The pipeline image (pipeline/Dockerfile; ADR 0033): CPU-only torch and the pinned
    // Foldseek, built for the host's architecture (linux/arm64 on the Mac, linux/amd64 in CI;
    // `make pipeline-image`). CPU only: Docker on macOS has no MPS.
    // Tasks run as the host user, so what they write on the host is the user's. Nextflow mounts
    // the work directory; the task commands also name the directories below by their host path
    // (the data cache with the release and the manifest, the log-probability and embedding
    // caches, the MLflow store, and the released outputs `train check-release` reads), so each
    // is mounted at that same path. The closure is evaluated per task, after every profile's
    // params are applied (-profile docker,test mounts the test profile's directories). The
    // paths must be absolute, as the defaults are.
    // The configs come from the image, as the code does: params.conf_dir points there.
    docker {
        docker.enabled          = true
        docker.runOptions       = '-u $(id -u):$(id -g)'
        process.container       = 'mutascope-pipeline:dev'
        params.conf_dir         = '/opt/mutascope/conf'
        // The Hugging Face cache (ESM-2 checkpoints, fetched at their pinned revisions) is in
        // the mounted data cache, so the image needs no home directory. Passed with -e, not
        // the env scope: Nextflow hands that to the container through an unquoted
        // `eval $(nxf_container_env)`, which splits a value at its spaces (this repo's path).
        process.containerOptions = {
            def mounts = [params.data_dir, params.processed_dir, params.results_dir,
                          params.tracking_dir, params.cache_dir, params.embedding_cache_dir]
                .findAll { it }
                .collect { it.toString() }
                .unique()
                .collect { "-v '${it}:${it}'" }
            (mounts + ["-e 'HF_HOME=${params.data_dir}/cache/huggingface'"]).join(' ')
        }
    }

    // Smoke test on 2 small assays (198 residues each, two function types). AICDA's PDB has a
    // TITLE record, which Foldseek appends to the entry name (build log entry 5, problem 1).
    // Outputs go to pipeline/results/ (gitignored), never over the real processed data.
    test {
        params.assays          = ['AICDA_HUMAN_Gajula_2014_3cycles', 'B2L11_HUMAN_Dutta_2010_binding-Mcl-1']
        params.processed_dir   = "${projectDir}/results/processed"
        params.reports_dir     = "${projectDir}/results/reports"
        params.results_dir     = "${projectDir}/results/benchmark"
        params.tracking_dir    = "${projectDir}/results/mlruns"
        // structure_exceptions: the real list names 4 specific assays, and check-structures fails
        // on any exception missing from the reference, which a 2-assay subset always triggers.
        // ~zero_shot_scores: skips the 1.9 GB archive; no Phase 1 step reads it.
        // esm2_8m: the 30 MB checkpoint the tests use, with both methods. cache_dir: a cache under
        // pipeline/results/, never the real one. The tasks of a run share it, as in a real run:
        // LANDSCAPES fills the entries SCORE_ZERO_SHOT wrote and CHECK_LANDSCAPES reads them.
        // `make pipeline-test` deletes it first, so the smoke test always runs the model.
        // msa_region_assays: same reason as structure_exceptions (none of the five is in the subset).
        // n_resamples: two assays give a meaningless CI either way; 200 keeps the task short.
        params.models          = ['esm2_8m']
        params.cache_dir       = "${projectDir}/results/logprob_cache"
        // Phase 3: features=smoke is seq_struct with esm2_8m in place of the two 650M models
        // (conf/features/smoke.yaml). train.final.min_variants=100: both assays are below the
        // deployed minimum (209 and 170 measured variants, of 300), and with none eligible
        // `train final` has nothing to fit. No release check: there is no release of 2 assays.
        params.feature_models  = ['esm2_8m']
        params.embedding_cache_dir = "${projectDir}/results/embedding_cache"
        params.release_check   = false
        params.extra_runs      = [['lgbm_pca', 'seq_struct'], ['mlp_mse', 'seq_struct']]
        params.hydra_overrides = 'data.structure_exceptions=null ~data.files.zero_shot_scores eval.scoring_region.msa_region_assays=null eval.bootstrap.n_resamples=200 features=smoke train.final.min_variants=100 train.min_variants.mlp_mse=100'
        process.resourceLimits = [cpus: 2, memory: 4.GB, time: 30.m]
    }
}

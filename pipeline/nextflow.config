manifest {
    name            = 'mutascope'
    description     = 'Functional-effect landscapes for single amino-acid substitutions'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.10'
}

params {
    outdir = "${launchDir}/data"
}

profiles {
    // Native run in the uv env: the only profile with MPS access on macOS.
    local {
        process.executor = 'local'
        env {
            PATH                        = "${projectDir}/../.venv/bin:\$PATH"
            PYTORCH_ENABLE_MPS_FALLBACK = '1'
        }
    }

    // CPU-only, linux/amd64 to match the deployment target. Image is built in Phase 4.
    docker {
        docker.enabled    = true
        docker.runOptions = '--platform linux/amd64 -u $(id -u):$(id -g)'
        process.container = 'mutascope:dev'
    }

    // Small, fast run for CI smoke tests (2 small assays once data modules exist).
    test {
        params.max_assays       = 2
        process.resourceLimits  = [cpus: 2, memory: 4.GB, time: 30.m]
    }
}
